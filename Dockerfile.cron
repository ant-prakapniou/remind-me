FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /src

COPY src/RemindMe.Core/RemindMe.Core.csproj src/RemindMe.Core/
COPY src/RemindMe.Cron/RemindMe.Cron.csproj src/RemindMe.Cron/
RUN dotnet restore src/RemindMe.Cron/RemindMe.Cron.csproj

COPY src/RemindMe.Core/ src/RemindMe.Core/
COPY src/RemindMe.Cron/ src/RemindMe.Cron/
RUN dotnet publish src/RemindMe.Cron/RemindMe.Cron.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/runtime:11.0
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["dotnet", "RemindMe.Cron.dll"]